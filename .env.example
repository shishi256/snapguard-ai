# Environment variables for SnapGuard AI
# Copy this file to .env and fill in real values
# NEVER commit .env with real tokens to version control

# ── Qualcomm AI Hub ──────────────────────────────────────────────────────────
# Required only for Qualcomm AI Hub model optimization workflow
# Get your token at: https://aihub.qualcomm.com/account/api-tokens
QAI_HUB_API_TOKEN=YOUR_TOKEN_HERE

# ── Optional Configuration ───────────────────────────────────────────────────
# Override default camera index (0 = built-in webcam)
# SNAPGUARD_CAMERA_INDEX=0

# Override models directory path
# SNAPGUARD_MODELS_DIR=/path/to/models
